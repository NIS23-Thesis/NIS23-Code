{
  "num_ch": 4,
  "num_sn": 20,
  "runtime": {
    "duration_s": 300.0,
    "seed": 810,
    "startup_delay_s": 10.0,
    "readiness_timeout_s": 180.0,
    "start_tolerance_s": 5.0,
    "radio_execution": "thread"
  },
  "mobility": {
    "model": "gauss_markov",
    "initial_topology": "random",
    "tick_interval": 0.5,
    "alpha": 0.5,
    "area_width_m": 500,
    "area_height_m": 500,
    "ch_mean_speed_mps": 0.0,
    "sn_mean_speed_mps": 0.0,
    "speed_stddev": 0.0,
    "direction_stddev": 0.5,
    "pause_trigger": "zero_speed"
  },
  "link": {
    "range_mode": "rssi",
    "pathloss_exponent": 3.0,
    "rssi0_dbm": -30.0,
