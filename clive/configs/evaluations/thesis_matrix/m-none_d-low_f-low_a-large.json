    "max_data_rate_bps": 1000000000.0
  },
  "logging": {
    "protocol_events": false,
    "packet_events": false,
    "mobility_tsv": false
  },
  "flame": {
    "sample_source": "mnist",
    "trainer": "mnist",
    "mnist_distribution": "spatial_clusters",
    "repeat_sensor_samples": false,
    "sample_interval_s": 60.0,
    "evaluate_accuracy": true,
    "save_final_model": true
  }
